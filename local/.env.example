# ─────────────────────────────────────────────────────────────
# MCA Logistics — Voice AI Agent — example environment
# Copy to `.env` and adjust. NEVER commit a filled-in .env.
# ─────────────────────────────────────────────────────────────

# ── Shared ───────────────────────────────────────────────────
RUST_LOG=info,sqlx=warn,tower_http=warn
APP_ENV=development

# ── voice-service ────────────────────────────────────────────
VOICE_HOST=0.0.0.0
VOICE_HTTP_PORT=8080
VOICE_GRPC_PORT=50051
AI_GRPC_URL=http://ai-service:50051
AI_GRPC_TIMEOUT_MS=15000
# mock | none  (mock = no telephony server required)
VOICE_TELEPHONY_PROVIDER=mock
VOICE_TELEPHONY_URL=
# max concurrent voice sessions (bounded concurrency)
VOICE_MAX_SESSIONS=512
VOICE_AUDIO_SAMPLE_RATE=8000
VOICE_TURN_TIMEOUT_MS=10000
VOICE_RETRY_ATTEMPTS=2
VOICE_IDLE_TIMEOUT_SEC=300

# ── ai-service ───────────────────────────────────────────────
AI_HOST=0.0.0.0
AI_HTTP_PORT=8081
AI_GRPC_PORT=50051
DATABASE_URL=postgres://mca:mca@localhost:5432/mca
DATABASE_MAX_CONNECTIONS=10
DATABASE_ACQUIRE_TIMEOUT_MS=5000

# ── LLM provider (OpenAI-compatible HTTP) ─────────────────────
# LLM_PROVIDER=fake  -> deterministic offline provider (default, no keys needed)
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=700
LLM_TIMEOUT_MS=8000
LLM_RETRY_ATTEMPTS=2
LLM_CONTEXT_RECENT_TURNS=8

# ── STT provider ─────────────────────────────────────────────
# STT_PROVIDER=fake -> deterministic offline provider
STT_PROVIDER=fake
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=
STT_LANGUAGE=ru
STT_TIMEOUT_MS=5000
STT_RETRY_ATTEMPTS=2

# ── TTS provider ─────────────────────────────────────────────
# TTS_PROVIDER=fake -> deterministic offline provider
TTS_PROVIDER=fake
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=alloy
TTS_FORMAT=pcm16
TTS_TIMEOUT_MS=5000
TTS_RETRY_ATTEMPTS=2

# ── CRM provider ─────────────────────────────────────────────
# CRM_PROVIDER=log -> logs the payload (no external call)
CRM_PROVIDER=log
CRM_BASE_URL=
CRM_API_KEY=

# ── Email ────────────────────────────────────────────────────
EMAIL_COMPOSER_ENABLED=true
MANAGER_EMAIL=logistics@mca-logistics.example
COMPANY_NAME=MCA Logistics

# ── Fake provider fault injection (used by tests/CI) ─────────
# one of: success | timeout | invalid_response | provider_error | rate_limited
FAKE_PROVIDER_MODE=success

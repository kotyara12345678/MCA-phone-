# MCA-phone production environment. Copy to .env and fill in secrets.
# This file holds secrets and host-specific values only; behavior lives in
# ai-agent.yaml.
#
# AVA (ai_engine + local_ai_server) expects most of these; the MCA_* block is
# the integration glue to the MCA Mail voice API.

COMPOSE_PROJECT_NAME=mca-phone

# ---------- MCA integration (required) ---------------------------------
# Where ai_engine reaches the MCA Mail API. Host network: 127.0.0.1:8080.
MCA_API_URL=http://127.0.0.1:8080
# API key minted against the mca-mail server (role operator or better):
#   docker compose exec mca-mail /app/mca-mail api-key create <name> operator
# Then put the printed key here.
MCA_API_KEY=
# The handoff allowlist value the agent sends when handing a lead to a manager.
# Keep the default unless you changed MANAGER_KEY_ALLOWLIST in crates/mca-mail.
MCA_MANAGER_KEY=mca_manager
# Asterisk extension dialed by the transfer tool (must match extensions in
# ai-agent.yaml). Used by ops only — the manager routing itself is server-sided.
MCA_MANAGER_EXTENSION=6000
# Recipient used by built-in email tools (optional).
ADMIN_EMAIL=

# ---------- Required: AI provider keys ----------------------------------
# Pipeline mca_hybrid (STT + LLM + TTS) routes everything through Polza.
# URL lines are optional: ai-agent.yaml already defaults to these values.
POLZA_API_KEY=
#POLZA_LLM_URL=https://polza.ai/api/v1
#POLZA_STT_URL=https://polza.ai/api/v1/audio/transcriptions
#POLZA_TTS_URL=https://polza.ai/api/v1/audio/speech
# TTS voice accepted by google/gemini-3.8-flash-tts on the Polza gateway.
#POLZA_TTS_VOICE=alloy
# AVA strips inline api_key from openai_* provider blocks unless OPENAI_API_KEY
# is set (env-only contract, src/config/security.py) — repeat the Polza key
# under this name even when the pipeline routes everything through Polza.
OPENAI_API_KEY=
GROQ_API_KEY=
ELEVENLABS_API_KEY=
# Voice override (Russian ElevenLabs voice id, e.g. a verified RU voice).
ELEVENLABS_VOICE_ID=
DEEPGRAM_API_KEY=
XAI_API_KEY=
GOOGLE_API_KEY=
AZURE_SPEECH_KEY=

# ---------- Required: Asterisk ARI / telephony --------------------------
# ai_engine connects to Asterisk ARI over loopback (host network).
ASTERISK_HOST=127.0.0.1
ASTERISK_ARI_PORT=8088
ASTERISK_ARI_USERNAME=asterisk
ASTERISK_ARI_PASSWORD=changeme
# User/group the container aligns to (FreePBX standard is 995).
ASTERISK_GID=995

# ---------- Required: mca-mail database ---------------------------------
# The postgres service in this compose shares the same variable.
POSTGRES_PASSWORD=changeme-strong-password
# mca-mail's own agent LLM (OpenAI-compatible endpoint). Required at boot
# unless LLM_PROVIDER=mock. Voice endpoints do not call it.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://polza.ai/api/v1
LLM_API_KEY=pza_REPLACE_WITH_POLZA_KEY
LLM_MODEL=openai/gpt-6-luna
# ---------- Real mailbox (this host is also the email responder) ---------
# IMAP read + SMTP send for info@mca-log.com. With MAIL_PROVIDER=imap the
# production guards accept APP_ENV=production; the mock refusal only applies
# to MAIL_PROVIDER=mock (voice-only hosts without a mailbox).
MAIL_PROVIDER=imap
MAIL_MODE=read_write
MAIL_USERNAME=info@mca-log.com
MAIL_PASSWORD=REPLACE_WITH_MAILBOX_PASSWORD
MAIL_IMAP_HOST=mail.es1mx.net
MAIL_IMAP_PORT=993
MAIL_IMAP_TLS=implicit
MAIL_INBOX=INBOX
MAIL_SMTP_HOST=mail.es1mx.net
MAIL_SMTP_PORT=3525
MAIL_SMTP_TLS=implicit
MAIL_FROM_ADDRESS=info@mca-log.com
MAIL_FROM_NAME="MCA Logistics"
# Instant push on new mail (IMAP IDLE) + short poll fallback.
MAIL_IDLE=true
MAIL_IDLE_FALLBACK_POLL_SECONDS=30
MAIL_POLL_INTERVAL_SECONDS=60
# Where convicted spam is moved (needs an explicit name when the server
# carries no SPECIAL-USE \Junk attribute).
MAIL_SPAM_FOLDER=Junk
MAIL_SENT_FOLDER=Sent
APP_ENV=production
# auto: the agent drafts are approved and dispatched without manual review;
# EMAIL_AUTO_SEND=true opens the actual SMTP gate (both must allow sending).
EMAIL_MODE=auto
EMAIL_AUTO_SEND=true
SEND_MANAGER_CARD=true
MANAGER_CARD_RECIPIENT=savva.toch@gmail.com
RETENTION_DAYS=365

# ---------- Local AI server (fallback; not used by mca_hybrid) -----------
# Russian STT: download vosk-model-ru-0.42 into ./models/stt and point here.
LOCAL_STT_MODEL_PATH=models/stt/vosk-model-ru-0.42
# Russian local TTS (Silero) requires rebuilding local_ai_server with
# INCLUDE_SILERO=true:
#LOCAL_TTS_MODEL_PATH=models/tts/silero
#LOCAL_TTS_BACKEND=silero
#SILERO_SPEAKER=xenia
#SILERO_LANGUAGE=ru
LOCAL_WS_URL=ws://127.0.0.1:8765
LOCAL_WS_HOST=127.0.0.1
LOCAL_WS_PORT=8765
LOCAL_WS_AUTH_TOKEN=
LOCAL_STT_BACKEND=vosk
LOCAL_TTS_BACKEND=piper

# ---------- Optional: call history / diagnostics ------------------------
CALL_HISTORY_ENABLED=true
CALL_HISTORY_RETENTION_DAYS=0
CALL_HISTORY_DB_PATH=/app/data/call_history.db
DIAG_ENABLE_TAPS=false

# ---------- Logging / misc ----------------------------------------------
TZ=Europe/Moscow
LOG_LEVEL=info
LOG_FORMAT=json
STREAMING_LOG_LEVEL=info
# Admin UI JWT secret (auto-generated by AVA preflight if you run it).
JWT_SECRET=change-me-32-hex